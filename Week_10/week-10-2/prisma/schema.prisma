model Users {
  id Int @id @default(autoincrement())
  email String @unique
  firstName String? // This ? is to enusre that this field is optional
  lastName String?
  password String
}

model Todos {
  user_id Int @id @default(autoincrement())
  title String
  description String?
  done Boolean
}
